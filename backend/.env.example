# SkillBridge AI Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# MongoDB Configuration (Leave as default for auto-fallback or provide MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=skillbridge_ai

# Security & JWT
JWT_SECRET=skillbridge_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
